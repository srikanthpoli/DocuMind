# Environment files and secrets
**/.env
**/.env.*
!**/.env.example

# Python and uv
**/.venv/
**/__pycache__/
**/*.py[cod]

# Angular and Node
**/node_modules/
**/dist/
**/.angular/
npm-debug.log*

# Local RAG data and user uploads
**/chroma_db/*
!**/chroma_db/
!**/chroma_db/.gitkeep
**/uploaded_docs/*
!**/uploaded_docs/
!**/uploaded_docs/.gitkeep

# Editors and operating-system files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
